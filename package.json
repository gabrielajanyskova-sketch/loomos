{
  "name": "loomos",
  "version": "1.0.0",
  "description": "LOOMOS — e-shop s ručně vyráběnými sójovými svíčkami (Cloudflare Pages + Functions + D1).",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "format": "prettier --write \"*.html\" \"produkty/*.html\" \"admin/*.html\" \"assets/css/store.css\" \"assets/js/*.js\" \"assets/js/*.mjs\" \"scripts/*.mjs\" \"src/**/*.js\" \"functions/**/*.js\" \"tests/**/*.mjs\" \"data/*.json\" package.json README.md \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"*.html\" \"produkty/*.html\" \"admin/*.html\" \"assets/css/store.css\" \"assets/js/*.js\" \"assets/js/*.mjs\" \"scripts/*.mjs\" \"src/**/*.js\" \"functions/**/*.js\" \"tests/**/*.mjs\" \"data/*.json\" package.json README.md \".github/workflows/*.yml\"",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "dev": "npm run build && wrangler pages dev dist --d1 DB --persist-to .local/wrangler --binding ADMIN_PASSWORD=mistni-heslo-admin BANK_ACCOUNT=19-2000145399/0800"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "qrcode-generator": "^1.4.4",
    "wrangler": "^4.156.2"
  },
  "engines": {
    "node": ">=22"
  }
}
